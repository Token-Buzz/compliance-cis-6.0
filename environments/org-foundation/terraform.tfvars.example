# Example variables for the org-foundation root.
#
# Copy this file to a real, gitignored tfvars (e.g. prod.tfvars) and replace the
# placeholders with this account's real values:
#
#   terraform plan -var-file=prod.tfvars
#
# The two bucket names are REQUIRED (no default) and must be globally unique.

# REQUIRED — globally-unique S3 bucket names. Suffix with the account id to keep
# them unique (account 421219980711 shown here as an example).
trail_log_bucket_name  = "cis-org-cloudtrail-logs-421219980711"
config_log_bucket_name = "cis-org-config-logs-421219980711"

# Optional — email subscribed to the CIS alarm SNS topic.
alarm_email = "security-alerts@example.com"

# Optional — object-level read data events for specific buckets.
s3_read_event_bucket_arns = [
  # "arn:aws:s3:::my-sensitive-bucket",
]

# Opt-in: CIS §5 CloudWatch metric-filter alarms (5.1–5.14). When true, a
# dedicated management-events-only CloudTrail trail is created that delivers to
# CloudWatch Logs, plus ~14 metric filters + alarms (so Prowler scores 5.1–5.14
# PASS). Costs ~$2–3/mo. monitoring_trail_log_bucket_name is REQUIRED when this
# is true and must be globally unique (suffix with the account id, as above).
# In CI these are supplied as repo Variables ENABLE_CLOUDWATCH_ALARMS and
# MONITORING_TRAIL_LOG_BUCKET_NAME (see terraform-deploy.yml).
enable_cloudwatch_alarms         = true
monitoring_trail_log_bucket_name = "cis-org-cloudtrail-monitoring-logs-421219980711"

# AWS Config and Security Hub are OFF by default to minimize cost. Their CIS
# coverage is provided instead by compensating controls (scheduled Prowler scans
# + Terraform drift detection), so the continuous-recording bill is avoided.
# Set either to true to create that service's resources in every active region.
# Note: CloudTrail uses free SSE-S3 encryption (no KMS key) with no CloudWatch
# Logs delivery; CIS monitoring runs via the EventBridge rules in monitoring-events.
enable_aws_config   = false
enable_security_hub = false

# Optional — turn on GuardDuty in every active region (off by default for cost).
enable_guardduty = false

# Optional — strip all rules from the default security group in every region.
restrict_default_security_group = true

# CIS 2.1 — primary account contact.
primary_contact = {
  full_name      = "Example Org Security"
  address_line_1 = "123 Example Street"
  city           = "Seattle"
  country_code   = "US"
  postal_code    = "98101"
  phone_number   = "+1-206-555-0100"
  # Optional fields:
  # address_line_2     = ""
  # state_or_region    = "WA"
  # company_name       = "Example, Inc."
  # website_url        = "https://example.com"
}

# CIS 2.2 — SECURITY alternate contact.
security_contact = {
  name          = "Security Operations"
  title         = "Security Team"
  email_address = "security@example.com"
  phone_number  = "+1-206-555-0101"
}

# Tags applied to every resource.
tags = {
  ManagedBy   = "terraform"
  Project     = "cis-aws-foundations-v6"
  Environment = "org-foundation"
}

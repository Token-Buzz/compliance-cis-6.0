# Example remote-state backend configuration for the org-foundation root.
#
# Copy this file to backend.hcl (kept out of version control) and fill in the
# values produced by the global/backend-bootstrap root, then run:
#
#   terraform init -backend-config=backend.hcl
#
# bucket comes from the global/backend-bootstrap `state_bucket` output.
# use_lockfile = true enables S3-native state locking (no DynamoDB table needed).
# region is the backend region (us-east-1 here).

bucket       = "REPLACE-WITH-state_bucket-FROM-backend-bootstrap"
key          = "org-foundation/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
